{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production-plan-v1.1",
  "title": "D执行模拟计划 v1.1",
  "type": "object",
  "required": [
    "schemaVersion", "planId", "mode", "status", "createdAt",
    "sourceAuthorizationId", "sourceAuthorizationRevision", "sourceAuthorizationFingerprint",
    "platform", "store", "skuPackageId", "sku", "titleVersion", "title", "attributeVersion",
    "attributes", "platformCategory", "buyerTargetPrice", "platformWritePrice", "priceConversion", "stock", "assetsFinalUploadsVersion", "finalUploads", "executionStrategy", "publishScope", "exclusions",
    "allowedWriteFields", "sourceReadPolicy", "sourceDataAccess", "productResearchPerformed",
    "platformWrites", "productCreated", "assetsUploaded", "readbackPerformed"
  ],
  "properties": {
    "schemaVersion": { "const": "production-plan-v1.1" },
    "planId": { "type": "string", "minLength": 1 },
    "mode": { "const": "simulation" },
    "status": { "const": "prepared" },
    "createdAt": { "type": "string", "format": "date-time" },
    "sourceAuthorizationId": { "type": "string", "minLength": 1 },
    "sourceAuthorizationRevision": { "type": "integer", "minimum": 0 },
    "sourceAuthorizationFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "platform": { "type": "string", "minLength": 1 },
    "store": { "type": "string", "minLength": 1 },
    "skuPackageId": { "type": "string", "minLength": 1 },
    "sku": {
      "type": "object",
      "required": ["supplierSkuId", "variantKey"],
      "properties": {
        "supplierSkuId": { "type": "string", "minLength": 1 },
        "variantKey": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "titleVersion": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "attributeVersion": { "type": "string", "minLength": 1 },
    "attributes": { "type": "object" },
    "platformCategory": { "type": "object" },
    "buyerTargetPrice": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "platformWritePrice": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "priceConversion": {
      "type": "object",
      "required": ["rubPerCny", "evidenceRef", "checkedAt"],
      "properties": {
        "rubPerCny": { "type": "number", "exclusiveMinimum": 0 },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "checkedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "stock": { "const": 100 },
    "assetsFinalUploadsVersion": { "type": "string", "minLength": 1 },
    "finalUploads": { "type": "array", "minItems": 1 },
    "executionStrategy": {
      "type": "object",
      "required": ["schemaVersion", "primaryPath", "browserRole", "automatedFields", "mediaMode", "manualActionsRequired", "forbiddenBrowserActions", "priceFieldRule", "stopOnFailure", "automaticRetry", "nextSkuAutomaticStart"],
      "properties": {
        "schemaVersion": { "const": "ozon-production-strategy-v1.0" },
        "primaryPath": { "const": "seller_api" },
        "manualActionsRequired": { "type": "integer", "minimum": 0, "maximum": 1 },
        "priceFieldRule": { "const": "platform_write_price_cny_only" },
        "stopOnFailure": { "const": true },
        "automaticRetry": { "const": false },
        "nextSkuAutomaticStart": { "const": false }
      },
      "additionalProperties": true
    },
    "publishScope": { "type": "string", "minLength": 1 },
    "exclusions": { "type": "array" },
    "allowedWriteFields": { "type": "array", "minItems": 1 },
    "sourceReadPolicy": { "const": "authorization_snapshot_only" },
    "sourceDataAccess": { "const": "production_authorization_only" },
    "productResearchPerformed": { "const": false },
    "platformWrites": { "const": 0 },
    "productCreated": { "const": false },
    "assetsUploaded": { "const": 0 },
    "readbackPerformed": { "const": false }
  },
  "additionalProperties": false
}
