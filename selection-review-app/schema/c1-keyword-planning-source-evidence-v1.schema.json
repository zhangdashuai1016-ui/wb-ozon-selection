{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c1-keyword-planning-source-evidence-v1.schema.json",
  "title": "C1 Keyword Planning Source Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locale", "expiresAt", "frozenSeoRules", "frozenComplexityDecision", "healthPolicy", "productFactTerms", "comparables", "seedEvidence", "quotaEvidence", "pointBudget", "keywordMetricEvidence", "reusableKeywordSnapshot", "reuseEvidenceNote"],
  "properties": {
    "schemaVersion": { "const": "c1-keyword-planning-source-evidence-v1" },
    "locale": { "type": "string", "minLength": 1 },
    "expiresAt": { "type": "string", "format": "date-time" },
    "frozenSeoRules": { "$ref": "c1-keyword-planning-evidence-v1.schema.json#/$defs/SeoRules" },
    "frozenComplexityDecision": { "oneOf": [{ "type": "null" }, { "$ref": "c1-keyword-planning-evidence-v1.schema.json#/$defs/ComplexityDecision" }] },
    "healthPolicy": { "$ref": "c1-keyword-planning-evidence-v1.schema.json#/$defs/HealthPolicy" },
    "productFactTerms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SourceTerm" } },
    "comparables": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "$ref": "#/$defs/SourceComparable" } },
    "seedEvidence": { "type": "array", "items": { "$ref": "#/$defs/SourceTerm" } },
    "quotaEvidence": { "oneOf": [{ "type": "null" }, { "$ref": "c1-keyword-planning-evidence-v1.schema.json#/$defs/QuotaEvidence" }] },
    "pointBudget": { "oneOf": [{ "type": "null" }, { "$ref": "c1-keyword-planning-evidence-v1.schema.json#/$defs/PointBudget" }] },
    "keywordMetricEvidence": { "$ref": "c1-keyword-planning-evidence-v1.schema.json#/$defs/KeywordMetricEvidence" },
    "reusableKeywordSnapshot": { "oneOf": [{ "type": "null" }, { "$ref": "keyword-evidence-snapshot-v1.schema.json" }] },
    "reuseEvidenceNote": { "type": ["string", "null"] }
  },
  "$defs": {
    "StringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "SourceTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "sourceRefs", "factRefs", "factBindings", "sourceTrust", "matchType"],
      "properties": {
        "term": { "type": "string", "minLength": 1 },
        "sourceRefs": { "$ref": "#/$defs/StringList" },
        "factRefs": { "$ref": "#/$defs/StringList" },
        "factBindings": { "$ref": "#/$defs/FactBindings" },
        "competitorRefs": { "$ref": "#/$defs/StringList" },
        "sourceTrust": { "type": ["string", "null"] },
        "matchType": { "enum": ["target_fact", "exact_match", "substitute", "multi_seed"] }
      }
    },
    "SourceComparable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["competitorRef", "seerfarSku", "platform", "matchType", "comparabilityStatus", "comparabilityEvidenceRefs", "factRefs", "factBindings", "useForReverseLookup", "organicTraffic", "manualSelectionRank", "selectionEvidenceRef", "terms"],
      "properties": {
        "competitorRef": { "type": "string", "minLength": 1 },
        "seerfarSku": { "type": ["string", "integer"] },
        "platform": { "enum": ["ozon", "wb"] },
        "matchType": { "enum": ["exact_match", "substitute"] },
        "comparabilityStatus": { "const": "proven" },
        "comparabilityEvidenceRefs": { "$ref": "#/$defs/StringList" },
        "factRefs": { "$ref": "#/$defs/StringList" },
        "factBindings": { "$ref": "#/$defs/FactBindings" },
        "useForReverseLookup": { "type": "boolean" },
        "organicTraffic": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "period", "evidenceRef"],
              "properties": {
                "value": { "type": "number", "minimum": 0 },
                "period": { "type": "string", "minLength": 1 },
                "evidenceRef": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "manualSelectionRank": { "type": "integer", "minimum": 1 },
        "selectionEvidenceRef": { "type": "string", "minLength": 1 },
        "terms": { "type": "array", "items": { "$ref": "#/$defs/SourceTerm" } }
      }
    },
    "FactBindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FactBinding" } },
    "FactBinding": { "type": "object", "additionalProperties": false, "required": ["factPath", "factValueFingerprint", "sourceRef", "bindingRelation", "semanticProofRef"], "properties": { "factPath": { "type": "string", "minLength": 1 }, "factValueFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "sourceRef": { "type": "string", "minLength": 1 }, "bindingRelation": { "const": "exact_value" }, "semanticProofRef": { "type": "null" } } }
  }
}
