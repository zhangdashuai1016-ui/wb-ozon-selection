{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c1-ai-draft-payment-authorization-v1",
  "title": "C1 single-call payment authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "proposalRef", "proposalFingerprint", "requestFingerprint", "executionPolicy"],
  "properties": {
    "schemaVersion": { "const": "c1-ai-draft-payment-authorization-v1" },
    "proposalRef": { "$ref": "#/$defs/reference" },
    "proposalFingerprint": { "$ref": "#/$defs/fingerprint" },
    "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
    "executionPolicy": { "$ref": "#/$defs/executionPolicy" }
  },
  "$defs": {
    "reference": { "$ref": "c1-ai-authorized-execution-v1#/$defs/canonicalFrozenRef" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "quoteRef", "quotedAt", "expiresAt", "maximumAmountMinor", "currency", "currencyScale", "maxCalls", "allowZeroCharge"],
      "properties": {
        "schemaVersion": { "const": "c1-ai-draft-quote-v1" },
        "quoteRef": { "$ref": "#/$defs/reference" },
        "quotedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "maximumAmountMinor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "currencyScale": { "type": "integer", "minimum": 0, "maximum": 6 },
        "maxCalls": { "const": 1 },
        "allowZeroCharge": { "type": "boolean" }
      },
      "allOf": [{
        "if": { "properties": { "maximumAmountMinor": { "const": 0 } }, "required": ["maximumAmountMinor"] },
        "then": { "properties": { "allowZeroCharge": { "const": true } } }
      }]
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "policyRef", "configurationVersion", "provider", "modelVersion", "credentialAlias", "serviceBindingRef", "serviceContractVersion", "allowedWorkerIds", "quote"],
      "properties": {
        "schemaVersion": { "const": "c1-ai-draft-execution-policy-v1" },
        "policyRef": { "$ref": "#/$defs/reference" },
        "configurationVersion": { "$ref": "#/$defs/reference" },
        "provider": { "enum": ["terra", "sol"] },
        "modelVersion": { "enum": ["gpt-5.6-terra", "gpt-5.6-sol"] },
        "credentialAlias": { "$ref": "#/$defs/reference" },
        "serviceBindingRef": { "$ref": "#/$defs/reference" },
        "serviceContractVersion": { "$ref": "#/$defs/reference" },
        "allowedWorkerIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
        "quote": { "$ref": "#/$defs/quote" }
      },
      "allOf": [{
        "if": { "properties": { "provider": { "const": "terra" } }, "required": ["provider"] },
        "then": { "properties": { "modelVersion": { "const": "gpt-5.6-terra" } } },
        "else": { "properties": { "modelVersion": { "const": "gpt-5.6-sol" } } }
      }]
    }
  }
}
