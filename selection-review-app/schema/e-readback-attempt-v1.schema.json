{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "e-readback-attempt-v1",
  "title": "系统创建商品独立读取持久记录 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "attemptId", "candidateId", "skuPackageId", "sourceProductionRecordId", "sourceFingerprint", "requestedByUserId", "startedAt", "completedAt", "status", "externalRequestState", "result", "applicationDisposition", "automaticRetry", "platformWrites"],
  "properties": {
    "schemaVersion": { "const": "e-readback-attempt-v1" },
    "attemptId": { "type": "string", "minLength": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "skuPackageId": { "type": "string", "minLength": 1 },
    "sourceProductionRecordId": { "type": "string", "minLength": 1 },
    "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requestedByUserId": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "status": { "enum": ["in_flight", "verified", "not_verified", "unknown_outcome", "not_applied"] },
    "externalRequestState": { "enum": ["not_sent", "in_flight", "succeeded", "unknown_outcome"] },
    "result": { "oneOf": [{ "type": "null" }, { "$ref": "e-system-readback-v1" }] },
    "applicationDisposition": { "enum": ["pending", "recorded", "applied", "source_conflict_not_applied", "reconciliation_required_not_applied"] },
    "automaticRetry": { "const": false },
    "platformWrites": { "const": 0 },
    "softwareJobRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "revision", "workerId", "leaseId"],
      "properties": {
        "jobId": { "$ref": "c1-ai-draft-request-v1#/$defs/canonicalFrozenRef" },
        "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "workerId": { "$ref": "c1-ai-draft-request-v1#/$defs/canonicalFrozenRef" },
        "leaseId": { "$ref": "c1-ai-draft-request-v1#/$defs/canonicalFrozenRef" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "in_flight" } }, "required": ["status"] },
      "then": { "properties": { "completedAt": { "type": "null" }, "result": { "type": "null" }, "applicationDisposition": { "const": "pending" }, "externalRequestState": { "enum": ["not_sent", "in_flight"] } } },
      "else": { "properties": { "completedAt": { "type": "string", "format": "date-time" }, "result": { "$ref": "e-system-readback-v1" }, "applicationDisposition": { "enum": ["recorded", "applied", "source_conflict_not_applied", "reconciliation_required_not_applied"] }, "externalRequestState": { "enum": ["not_sent", "succeeded", "unknown_outcome"] } } }
    },
    {
      "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
      "then": { "properties": { "applicationDisposition": { "const": "applied" }, "externalRequestState": { "const": "succeeded" } } },
      "else": { "properties": { "applicationDisposition": { "enum": ["pending", "recorded", "source_conflict_not_applied", "reconciliation_required_not_applied"] } } }
    },
    {
      "if": { "properties": { "status": { "const": "not_applied" } }, "required": ["status"] },
      "then": { "properties": { "applicationDisposition": { "enum": ["source_conflict_not_applied", "reconciliation_required_not_applied"] } } },
      "else": { "properties": { "applicationDisposition": { "enum": ["pending", "recorded", "applied"] } } }
    },
    {
      "if": { "properties": { "applicationDisposition": { "const": "reconciliation_required_not_applied" } }, "required": ["applicationDisposition"] },
      "then": { "properties": { "softwareJobRef": { "$ref": "#/properties/softwareJobRef" } }, "required": ["softwareJobRef"] }
    },
    {
      "if": { "properties": { "status": { "const": "unknown_outcome" } }, "required": ["status"] },
      "then": { "properties": { "externalRequestState": { "const": "unknown_outcome" } } }
    }
  ]
}
