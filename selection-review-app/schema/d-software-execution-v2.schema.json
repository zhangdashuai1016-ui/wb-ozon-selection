{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "d-software-execution-v2",
  "title": "单SKU D软件执行契约 v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "status"
  ],
  "properties": {
    "executableRequest": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "independentReadback": {
          "type": "object",
          "required": [
            "expectation"
          ],
          "properties": {
            "expectation": {
              "$ref": "production-record-v1.1#/$defs/readbackExpectation"
            }
          }
        },
        "sourceAuthorizationVersion": {
          "const": "production-authorization-v1.2"
        },
        "executionProtocolVersion": {
          "const": "ozon-single-sku-d-e-v3"
        }
      },
      "required": [
        "sourceAuthorizationVersion",
        "independentReadback",
        "executionProtocolVersion"
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "sourceAuthorizationVersion",
        "independentReadback",
        "executionProtocolVersion"
      ],
      "properties": {
        "independentReadback": {
          "type": "object",
          "required": [
            "expectation"
          ],
          "properties": {
            "expectation": {
              "$ref": "production-record-v1.1#/$defs/readbackExpectation"
            }
          }
        },
        "sourceAuthorizationVersion": {
          "const": "production-authorization-v1.2"
        },
        "executionProtocolVersion": {
          "const": "ozon-single-sku-d-e-v3"
        }
      }
    },
    "schemaVersion": {
      "const": "d-software-execution-v2"
    },
    "status": {
      "enum": [
        "not_ready",
        "ready",
        "in_flight",
        "failed",
        "unknown_outcome",
        "succeeded",
        "waiting_platform"
      ]
    },
    "executionKey": {
      "type": "string",
      "minLength": 1
    },
    "gaps": {
      "type": "array"
    },
    "retryAllowed": {
      "const": false
    },
    "productionRecord": {
      "type": [
        "object",
        "null"
      ]
    },
    "executionPolicy": {
      "type": "object",
      "properties": {
        "path": {
          "const": "ozon_seller_api"
        },
        "batchSize": {
          "const": 1
        },
        "attemptLimit": {
          "const": 1
        },
        "automaticRetry": {
          "const": false
        },
        "browserFallback": {
          "const": false
        },
        "manualFallback": {
          "const": false
        },
        "codexDispatch": {
          "const": false
        },
        "nextSkuAutomaticStart": {
          "const": false
        }
      }
    }
  }
}