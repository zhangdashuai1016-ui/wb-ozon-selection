{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-job-admission-v1.schema.json",
  "title": "Software job admission contracts v1",
  "$defs": {
    "deExecutionBindingSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "serviceId",
        "serviceConfigurationVersion",
        "productionBinding",
        "platform",
        "storeRef",
        "warehouseRef",
        "credentialAlias",
        "workerId",
        "workerVersion",
        "configurationEvidence"
      ],
      "properties": {
        "schemaVersion": {
          "const": "d-e-execution-binding-v1"
        },
        "serviceId": {
          "$ref": "software-job-v1.schema.json#/$defs/deSourceRef"
        },
        "serviceConfigurationVersion": {
          "$ref": "software-job-v1.schema.json#/$defs/deSourceRef"
        },
        "productionBinding": {
          "$ref": "software-job-v1.schema.json#/$defs/deProductionBinding"
        },
        "platform": {
          "const": "ozon"
        },
        "storeRef": {
          "$ref": "software-job-v1.schema.json#/$defs/deStoreRef"
        },
        "warehouseRef": {
          "$ref": "software-job-v1.schema.json#/$defs/deSourceRef"
        },
        "credentialAlias": {
          "$ref": "software-job-v1.schema.json#/$defs/deSourceRef"
        },
        "workerId": {
          "$ref": "software-job-v1.schema.json#/$defs/deSourceRef"
        },
        "workerVersion": {
          "$ref": "software-job-v1.schema.json#/$defs/deSourceRef"
        },
        "configurationEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceRef",
            "checkedAt",
            "expiresAt"
          ],
          "properties": {
            "evidenceRef": {
              "$ref": "software-job-v1.schema.json#/$defs/deSourceRef"
            },
            "checkedAt": {
              "type": "string",
              "format": "date-time"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "deSoftwareJobAdmissionDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "admissionKind",
        "admissionId",
        "jobId",
        "candidateId",
        "skuPackageId",
        "revision",
        "jobType",
        "normalizedScopeKey",
        "authorizationRef",
        "authorizationFingerprint",
        "sourceFingerprint",
        "phase",
        "observedAt",
        "executionBindingSnapshot"
      ],
      "properties": {
        "schemaVersion": {
          "const": "software-job-admission-v1"
        },
        "admissionKind": {
          "const": "domain_handoff"
        },
        "admissionId": {
          "$ref": "#/$defs/strictRef",
          "type": "string",
          "pattern": "^software-job-admission:[a-f0-9]{64}$"
        },
        "jobId": {
          "$ref": "#/$defs/strictRef"
        },
        "candidateId": {
          "$ref": "#/$defs/strictRef"
        },
        "skuPackageId": {
          "$ref": "#/$defs/strictRef"
        },
        "revision": {
          "$ref": "software-job-v1.schema.json#/$defs/deRevision"
        },
        "jobType": {
          "enum": [
            "d_production_execution",
            "e_independent_readback"
          ]
        },
        "normalizedScopeKey": {
          "$ref": "#/$defs/strictRef",
          "type": "string",
          "pattern": "^software-job-scope:[a-f0-9]{64}$"
        },
        "authorizationRef": {
          "$ref": "software-job-v1.schema.json#/$defs/deOpaqueSourceRef"
        },
        "authorizationFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "sourceFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "phase": {
          "enum": [
            "enqueue_current",
            "claim",
            "external_request"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "executionBindingSnapshot": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/deExecutionBindingSnapshot"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "enqueue_current"
              }
            },
            "required": [
              "phase"
            ]
          },
          "then": {
            "properties": {
              "executionBindingSnapshot": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "executionBindingSnapshot": {
                "$ref": "#/$defs/deExecutionBindingSnapshot"
              }
            }
          }
        }
      ]
    },
    "softwareJobAdmissionDecision": {
      "oneOf": [
        {
          "$ref": "#/$defs/credentialSoftwareJobAdmissionDecision"
        },
        {
          "$ref": "#/$defs/deSoftwareJobAdmissionDecision"
        }
      ]
    },
    "strictRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=.{1,256}$)(?!.*[\\u0000-\\u001f\\s?#@=&\\\\])(?!(?:[Ff][Ii][Ll][Ee]:|[Hh][Tt][Tt][Pp][Ss]?:|/|\\\\|[A-Za-z]:[\\\\/]))(?!.*//)[A-Za-z0-9][A-Za-z0-9._:~-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "storeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableStoreId",
        "platformStoreId",
        "mappingVersion"
      ],
      "properties": {
        "stableStoreId": {
          "$ref": "#/$defs/strictRef"
        },
        "platformStoreId": {
          "$ref": "#/$defs/strictRef"
        },
        "mappingVersion": {
          "$ref": "#/$defs/strictRef"
        }
      }
    },
    "stableAssetHosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?=.{1,253}$)(?!-)(?!.*(?:^|\\.)(?:localhost|local|localdomain|lan|home|internal)$)(?:[a-z0-9-]+\\.)+[a-z]{2,63}$"
      }
    },
    "c2StableAssetTransportAuthorizationRecord": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "useCount": {
                "const": 0
              }
            },
            "required": [
              "useCount"
            ]
          },
          "then": {
            "properties": {
              "consumedByJobId": {
                "type": "null"
              },
              "consumedAt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "useCount": {
                "const": 1
              }
            },
            "required": [
              "useCount"
            ]
          },
          "then": {
            "properties": {
              "consumedByJobId": {
                "$ref": "#/$defs/strictRef"
              },
              "consumedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ],
      "required": [
        "schemaVersion",
        "authorizationId",
        "status",
        "action",
        "candidateId",
        "skuPackageId",
        "sourceRevision",
        "resultRevision",
        "platform",
        "storeRef",
        "supplierSkuId",
        "variantKey",
        "sideEffectScope",
        "stagedAssetManifestFingerprint",
        "ownerStagingConfirmationRef",
        "allowedStableAssetHosts",
        "authorizedByUserId",
        "authorizedAt",
        "expiresAt",
        "maxUses",
        "useCount",
        "consumedByJobId",
        "consumedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "software-job-authorization-record-v1"
        },
        "authorizationId": {
          "$ref": "#/$defs/strictRef"
        },
        "status": {
          "const": "active"
        },
        "action": {
          "const": "c2_stable_asset_transport"
        },
        "candidateId": {
          "$ref": "#/$defs/strictRef"
        },
        "skuPackageId": {
          "$ref": "#/$defs/strictRef"
        },
        "sourceRevision": {
          "type": "integer",
          "minimum": 0
        },
        "resultRevision": {
          "type": "integer",
          "minimum": 1
        },
        "platform": {
          "$ref": "#/$defs/strictRef"
        },
        "storeRef": {
          "$ref": "#/$defs/storeRef"
        },
        "supplierSkuId": {
          "$ref": "#/$defs/strictRef"
        },
        "variantKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sideEffectScope": {
          "const": "c2_stable_asset_transport"
        },
        "stagedAssetManifestFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "ownerStagingConfirmationRef": {
          "$ref": "#/$defs/strictRef"
        },
        "allowedStableAssetHosts": {
          "$ref": "#/$defs/stableAssetHosts"
        },
        "authorizedByUserId": {
          "$ref": "#/$defs/strictRef"
        },
        "authorizedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "maxUses": {
          "const": 1
        },
        "useCount": {
          "enum": [
            0,
            1
          ]
        },
        "consumedByJobId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/strictRef"
            }
          ]
        },
        "consumedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
