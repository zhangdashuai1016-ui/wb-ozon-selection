            },
            "sourceRevision": {
              "type": "integer",
              "minimum": 0
            },
            "jobType": {
              "const": "c1_ai_draft"
            }
          }
        }
      }
    },
    "status": {
      "const": "waiting_platform"
    },
    "externalRequestState": {
      "const": "in_flight"
