{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profit-model-v1.1",
  "title": "ProfitModel v1.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "profitModelVersion",
    "calculatedAt",
    "inputSnapshotRefs",
    "marketAssessmentRef",
    "marketSampleRefs",
    "recommendedSalePriceRub",
    "recommendedSalePriceCny",
    "sellerSettlementRevenue",
    "commissionRate",
    "internationalFreight",
    "actualPurchaseCost",
    "otherCosts",
    "unitProfitRmb",
    "profitMargin",
    "thresholdVersion",
    "thresholds",
    "result",
    "executionMode",
    "externalAccesses",
    "requestedExistingFields",
    "formula"
  ],
  "properties": {
    "schemaVersion": { "const": "profit-model-v1.1" },
    "profitModelVersion": { "type": "string", "pattern": "^profit-v[1-9][0-9]*$" },
    "calculatedAt": { "type": "string", "format": "date-time" },
    "inputSnapshotRefs": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
    "marketAssessmentRef": { "type": "string", "minLength": 1 },
    "marketSampleRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "pricingPolicyVersion": { "const": "ozon-wb-global-pricing-2026-08-21-v3-project-or-threshold-v1" },
    "pricingMode": { "const": "source-market-fit" },
    "priceFloors": {
      "type": "object",
      "required": ["breakEvenPriceCny", "marginFloorCny", "minimumProfitFloorCny", "qualifyingFloorCny", "qualifyingLogic", "priceIncrementCny"],
      "properties": {
        "breakEvenPriceCny": { "type": "number", "minimum": 0 },
        "marginFloorCny": { "type": "number", "minimum": 0 },
        "minimumProfitFloorCny": { "type": "number", "minimum": 0 },
        "qualifyingFloorCny": { "type": "number", "minimum": 0 },
        "qualifyingLogic": { "const": "any" },
        "priceIncrementCny": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "marketFit": {
      "type": "object",
      "required": ["status", "marketReferencePriceCny", "qualifyingFloorCny", "headroomCny", "marketSampleCount", "preferredComparableCount", "comparableCountIsHardGate"],
      "properties": {
        "status": { "enum": ["fits_market", "above_market_needs_review", "market_conflict", "severe_market_conflict"] },
        "marketReferencePriceCny": { "type": "number", "exclusiveMinimum": 0 },
        "qualifyingFloorCny": { "type": "number", "minimum": 0 },
        "headroomCny": { "type": "number" },
        "floorPremiumRate": { "type": "number" },
        "marketSampleCount": { "type": "integer", "minimum": 0 },
        "preferredComparableCount": { "const": 5 },
        "comparableCountIsHardGate": { "const": false }
      },
      "additionalProperties": false
    },
    "costScope": { "type": "object" },
    "recommendedSalePriceRub": { "type": "number", "exclusiveMinimum": 0 },
    "recommendedSalePriceCny": { "type": "number", "exclusiveMinimum": 0 },
    "priceConversion": {
      "type": "object",
      "required": ["rubPerCny", "evidenceRef", "checkedAt"],
      "properties": {
        "rubPerCny": { "type": "number", "exclusiveMinimum": 0 },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "checkedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "sellerSettlementRevenue": { "$ref": "#/$defs/money" },
    "commissionRate": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
    "internationalFreight": { "$ref": "#/$defs/money" },
    "actualPurchaseCost": { "$ref": "#/$defs/money" },
    "otherCosts": { "$ref": "#/$defs/money" },
    "unitProfitRmb": { "type": "number" },
    "profitMargin": { "type": "number" },
    "thresholdVersion": { "enum": ["profit-threshold-v1.1-25pct-20cny", "profit-threshold-v1.2-15pct-or-20cny"] },
    "thresholds": {
      "type": "object",
      "required": ["minimumProfitMargin", "minimumUnitProfitRmb", "logic"],
      "properties": {
        "minimumProfitMargin": { "enum": [0.15, 0.25] },
        "minimumUnitProfitRmb": { "const": 20 },
        "logic": { "enum": ["any", "all"] }
      },
      "additionalProperties": false
    },
    "result": { "enum": ["passed", "rejected"] },
    "executionMode": { "const": "five_upstream_evidence_sources_only" },
    "externalAccesses": { "type": "array", "maxItems": 0 },
    "requestedExistingFields": { "type": "array", "maxItems": 0 },
    "formula": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "thresholdVersion": { "const": "profit-threshold-v1.1-25pct-20cny" } } },
      "then": {
        "properties": {
          "thresholds": {
            "properties": {
              "minimumProfitMargin": { "const": 0.25 },
              "minimumUnitProfitRmb": { "const": 20 },
              "logic": { "const": "all" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "thresholdVersion": { "const": "profit-threshold-v1.2-15pct-or-20cny" } } },
      "then": {
        "properties": {
          "thresholds": {
            "properties": {
              "minimumProfitMargin": { "const": 0.15 },
              "minimumUnitProfitRmb": { "const": 20 },
              "logic": { "const": "any" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "money": {
      "type": "object",
      "required": ["amount", "currency", "evidenceRef"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "minLength": 1 },
        "evidenceRef": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
