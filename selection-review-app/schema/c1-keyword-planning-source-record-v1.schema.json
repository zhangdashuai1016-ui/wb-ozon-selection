{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c1-keyword-planning-source-record-v1.schema.json",
  "title": "C1 Keyword Planning Source Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "candidateRevision", "skuPackageId", "recordedAt", "sourceEvidence", "sourceRefs"],
  "properties": {
    "schemaVersion": { "const": "c1-keyword-planning-source-record-v1" },
    "candidateId": { "type": "string", "minLength": 1 },
    "candidateRevision": { "type": "integer", "minimum": 0 },
    "skuPackageId": { "type": "string", "minLength": 1 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "sourceEvidence": { "$ref": "c1-keyword-planning-source-evidence-v1.schema.json" },
    "sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
