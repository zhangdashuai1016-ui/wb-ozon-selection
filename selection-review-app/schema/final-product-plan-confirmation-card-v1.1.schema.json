{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "final-product-plan-confirmation-card-v1.1",
  "title": "C阶段最终商品方案确认卡 v1.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "cardId",
    "status",
    "createdAt",
    "ownerDecision",
    "decisionOptions",
    "productInformation",
    "profitResult",
    "c1Facts",
    "seoDraft",
    "c2Assets",
    "riskAndUnknowns",
    "productionBoundary",
    "cardRevision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "final-product-plan-confirmation-card-v1.1"
    },
    "cardId": {
      "type": "string",
      "minLength": 1
    },
    "cardRevision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "awaiting_owner_business_confirmation",
        "owner_business_approved"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "ownerDecision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "decisionId",
            "selectedOption",
            "sourceConfirmationCardId",
            "ownerDecisionFingerprint",
            "ownerConfirmation"
          ],
          "properties": {
            "decisionId": {
              "type": "string",
              "minLength": 1
            },
            "selectedOption": {
              "const": "approve_for_production_authorization"
            },
            "sourceConfirmationCardId": {
              "type": "string",
              "minLength": 1
            },
            "ownerDecisionFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "ownerConfirmation": {
              "oneOf": [ { "$ref": "production-authorization-v1.1.schema.json#/properties/ownerConfirmation" }, { "$ref": "production-authorization-v1.2.schema.json#/properties/ownerConfirmation" } ]
            }
          }
        }
      ]
    },
    "decisionOptions": {
      "const": [
        "approve_for_production_authorization",
        "return_to_c_stage",
        "reject_product"
      ]
    },
    "productInformation": {
      "type": "object"
    },
    "profitResult": {
      "type": "object"
    },
    "c1Facts": {
      "type": "object"
    },
    "seoDraft": {
      "type": "object"
    },
    "c2Assets": {
      "type": "object",
      "required": [
        "sourceArea",
        "finalUploads",
        "ownerFinalUploadConfirmation"
      ],
      "properties": {
        "sourceArea": {
          "const": "assets.finalUploads"
        },
        "finalUploads": {
          "type": "array",
          "minItems": 1
        },
        "ownerFinalUploadConfirmation": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "riskAndUnknowns": {
      "type": "object"
    },
    "productionBoundary": {
      "type": "object",
      "required": [
        "productionAuthorized",
        "dStarted",
        "platformWrites",
        "requiresSeparateExactAuthorization",
        "authorizationScopeRequired"
      ],
      "properties": {
        "productionAuthorized": {
          "const": false
        },
        "dStarted": {
          "const": false
        },
        "platformWrites": {
          "const": 0
        },
        "requiresSeparateExactAuthorization": {
          "const": true
        },
        "authorizationScopeRequired": {
          "type": "array"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "awaiting_owner_business_confirmation"
          }
        }
      },
      "then": {
        "properties": {
          "ownerDecision": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "ownerDecision": {
            "type": "object"
          }
        }
      }
    }
  ]
}
