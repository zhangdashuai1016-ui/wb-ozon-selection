{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a-market-assessment-v1.1",
  "title": "A阶段市场样本评估 v1.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "assessmentId",
    "assessedAt",
    "sourceOpportunityRevision",
    "status",
    "businessResult",
    "technicalStatus",
    "ownerAction",
    "sellerPriority",
    "sampleSummaries",
    "primarySampleIds",
    "backgroundSampleIds",
    "excludedSampleIds",
    "sellerTypeCounts",
    "sellerTypesUsed",
    "identityConfirmation",
    "confidence",
    "priceBand",
    "recommendedSalePrice",
    "containsLocalRuBackground",
    "manualReviewRequired",
    "gateReason",
    "bEligibility",
    "rule"
  ],
  "properties": {
    "schemaVersion": { "const": "a-market-assessment-v1.1" },
    "assessmentId": { "type": "string", "minLength": 1 },
    "assessedAt": { "type": "string", "format": "date-time" },
    "sourceOpportunityRevision": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["passed", "data_gap"] },
    "businessResult": { "enum": ["passed", "pending"] },
    "technicalStatus": { "const": "completed" },
    "ownerAction": { "enum": ["confirm_supplier_option", "none"] },
    "sellerPriority": { "const": ["cross_border_cn", "other_cross_border", "unknown", "local_ru"] },
    "sampleSummaries": { "type": "array" },
    "primarySampleIds": { "type": "array", "items": { "type": "string" } },
    "backgroundSampleIds": { "type": "array", "items": { "type": "string" } },
    "excludedSampleIds": { "type": "array", "items": { "type": "string" } },
    "sellerTypeCounts": {
      "type": "object",
      "required": ["cross_border_cn", "other_cross_border", "unknown", "local_ru"],
      "properties": {
        "cross_border_cn": { "type": "integer", "minimum": 0 },
        "other_cross_border": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "local_ru": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sellerTypesUsed": { "type": "array", "items": { "enum": ["cross_border_cn", "other_cross_border", "unknown"] } },
    "identityConfirmation": { "type": "object" },
    "confidence": { "enum": ["high", "medium", "limited", "unavailable"] },
    "priceBand": { "type": ["object", "null"] },
    "recommendedSalePrice": { "type": ["object", "null"] },
    "containsLocalRuBackground": { "type": "boolean" },
    "manualReviewRequired": { "type": "boolean" },
    "gateReason": { "type": "string", "minLength": 1 },
    "bEligibility": { "enum": ["eligible_after_owner_supply_confirmation", "not_ready"] },
    "rule": { "const": "cross_border_cn_preferred_not_exclusive" }
  },
  "additionalProperties": false
}
